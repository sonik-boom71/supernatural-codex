# ─── База данных (опционально, для бэкенда форума/трекера) ───
DATABASE_URL="postgresql://user:password@localhost:5432/hunters_codex"
DIRECT_URL="postgresql://user:password@localhost:5432/hunters_codex"

# ─── Аутентификация (NextAuth) ───
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Кэш (Upstash Redis) ───
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ─── Прочее ───
RESEND_API_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Текущая статическая версия сайта работает БЕЗ этих переменных:
# данные хранятся в src/data, трекер просмотра — в localStorage.
