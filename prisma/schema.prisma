// ─────────────────────────────────────────────────────────────
// HUNTER'S CODEX — опциональная схема БД для бэкенда
// (форум, фанфики, трекер с аккаунтами, опросы).
// Текущая статическая версия сайта работает БЕЗ базы:
// контент в src/data, пользовательские данные — в localStorage.
// Чтобы включить бэкенд: настройте DATABASE_URL и выполните
//   npx prisma migrate dev
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Faction {
  HUNTER
  ANGEL
  DEMON
  GOD
  HUMAN
  MONSTER
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  username     String           @unique
  passwordHash String
  role         UserRole         @default(USER)
  watched      WatchedEpisode[]
  fanfics      Fanfic[]
  threads      ForumThread[]
  posts        ForumPost[]
  createdAt    DateTime         @default(now())
}

model Episode {
  id         Int              @id @default(autoincrement())
  season     Int
  number     Int
  title      String
  titleRu    String
  airDate    DateTime
  summary    String
  rating     Float?
  watchedBy  WatchedEpisode[]

  @@unique([season, number])
}

model WatchedEpisode {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  episode   Episode  @relation(fields: [episodeId], references: [id])
  episodeId Int
  watchedAt DateTime @default(now())
  rating    Int?

  @@id([userId, episodeId])
}

model ForumThread {
  id        Int         @id @default(autoincrement())
  title     String
  category  String
  author    User        @relation(fields: [authorId], references: [id])
  authorId  String
  posts     ForumPost[]
  createdAt DateTime    @default(now())
}

model ForumPost {
  id        Int         @id @default(autoincrement())
  body      String
  thread    ForumThread @relation(fields: [threadId], references: [id])
  threadId  Int
  author    User        @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime    @default(now())
}

model Fanfic {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    String
  tags      String[]
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model GhostStory {
  id        Int      @id @default(autoincrement())
  nickname  String
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    String
  optionId  String
  createdAt DateTime @default(now())

  @@index([pollId])
}
